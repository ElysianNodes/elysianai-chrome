{
  "manifest_version": 3,
  "name": "ElysianAI",
  "version": "1.0.1",
  "description": "ElysianAI extension that opens billing panel in browser sidebar",
  "permissions": [
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://billing.elysiannodes.uk/*"
  ],
  "background": {
    "service_worker": "background_chrome.js"
  },
  "action": {
    "default_title": "Open ElysianAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
